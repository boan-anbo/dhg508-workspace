    },
    {
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": [],
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 13,
      "frameId": null,
      "groupIds": [
